#!/usr/bin/env bash
# quick-ask: dispatch a prompt to the selected Omarchy agent/model.
# Usage: quick-ask <agent> <model> <prompt...>
# - agent: one of opencode|claude|codex|agy|copilot|grok|pi|omp|ori|crush|auto
# - model: provider/model for opencode (e.g. openai/gpt-5.6-sol) or empty
# - prompt: question text
#
# Prefers `opencode run` for provider/model routing and JSON streaming.
# Falls back to native binaries for non-opencode agents.
set -euo pipefail

# Quickshell supplies an open stdin pipe. OpenCode waits for that pipe to close,
# so detach non-interactive requests from stdin before dispatching an agent.
if [[ ! -t 0 ]]; then exec </dev/null; fi

# Run from /tmp to avoid any agent scanning git repositories, project context, or local dotfiles
cd /tmp || true

agent="${1:-opencode}"
model="${2:-}"
shift 2 || true
prompt="$*"

if [[ -z "${prompt//[[:space:]]/}" ]]; then
  echo "quick-ask: empty prompt" >&2
  exit 2
fi

# Normalize "auto" -> use Omarchy default agent if available
if [[ "$agent" == "auto" || "$agent" == "" ]]; then
  if command -v omarchy-default-agent >/dev/null 2>&1; then
    detected="$(omarchy-default-agent 2>/dev/null || true)"
    [[ -n "$detected" ]] && agent="$detected" || agent="opencode"
  else
    agent="opencode"
  fi
fi

# If model is empty, pick a sensible default per agent (must match Model.js:defaultModelFor)
if [[ -z "$model" ]]; then
  case "$agent" in
    opencode) model="openai/gpt-5.6-sol" ;;
    *) model="" ;;
  esac
fi

# Normalize legacy short names without provider prefix (must match Model.js:normalizeModel)
if [[ -n "$model" && "$model" != *"/"* ]]; then
  case "$model" in
    gpt-*|codex*) model="openai/$model" ;;
    claude-*) model="anthropic/$model" ;;
    gemini-*) model="google/$model" ;;
    *)
      echo "quick-ask: invalid model '$model' (expected provider/model)" >&2
      exit 2
      ;;
  esac
fi

# Validate model format if provided (must be provider/model)
if [[ -n "$model" ]] && ! [[ "$model" =~ ^[a-zA-Z0-9._-]+/[a-zA-Z0-9._:/-]+$ ]]; then
  echo "quick-ask: invalid model '$model' (expected provider/model)" >&2
  exit 2
fi

# Prefer Omarchy's OpenCode 2 client when available; it is the desktop-integrated client.
if command -v opencode2 >/dev/null 2>&1; then
  OPENCODE_BIN="opencode2"
elif command -v opencode >/dev/null 2>&1; then
  OPENCODE_BIN="opencode"
else
  OPENCODE_BIN=""
fi
has_opencode() { [[ -n "$OPENCODE_BIN" ]]; }

# For opencode-agent we route through the selected OpenCode client so provider/model are honored.
# For other agents we could still route via opencode if a provider/model is set,
# but native CLIs give better auth (oauth) for claude/codex/agy.
case "$agent" in
  opencode|open-code)
    if ! has_opencode; then
      echo "opencode is not installed. Install via: omarchy default agent opencode" >&2
      exit 3
    fi
    if [[ -n "$model" ]]; then
      exec "$OPENCODE_BIN" run --model "$model" --format json "$prompt"
    else
      exec "$OPENCODE_BIN" run --format json "$prompt"
    fi
    ;;
  claude|claude-code)
    # If a provider/model is selected and OpenCode is available, honor it (better model control).
    if [[ -n "$model" ]] && has_opencode; then
      exec "$OPENCODE_BIN" run --model "$model" --format json "$prompt"
    elif command -v claude >/dev/null 2>&1; then
      # Print mode exits after one response and preserves the user's permission policy.
      exec claude --print -- "$prompt"
    elif has_opencode; then
      exec "$OPENCODE_BIN" run --format json "$prompt"
    else
      echo "Claude Code not installed. Install via: omarchy default agent claude" >&2      exit 3
    fi
    ;;
  codex)
    if command -v codex >/dev/null 2>&1; then
      # Run non-interactively from the shell's non-git workdir without granting write access.
      # The selected provider prefix is for the UI catalog; Codex expects only the model name.
      codex_args=(exec --skip-git-repo-check --sandbox read-only)
      if [[ -n "$model" ]]; then codex_args+=(--model "${model#*/}"); fi
      exec codex "${codex_args[@]}" "$prompt"
    elif has_opencode; then
      exec opencode run --model "$model" --format json "$prompt"
    else
      echo "Codex not installed. Install via: omarchy default agent codex" >&2
      exit 3
    fi
    ;;
  agy|antigravity|gemini|gemini-cli)
    if [[ -n "$model" ]] && has_opencode; then
      exec opencode run --model "$model" --format json "$prompt"
    elif command -v agy >/dev/null 2>&1; then
      exec agy --prompt-interactive "$prompt"
    elif has_opencode; then
      exec opencode run --format json "$prompt"
    else
      echo "Antigravity (agy) not installed. Install via: omarchy default agent agy" >&2
      exit 3
    fi
    ;;
  copilot|github-copilot)
    if [[ -n "$model" ]] && has_opencode; then
      exec opencode run --model "$model" --format json "$prompt"
    elif command -v copilot >/dev/null 2>&1; then
      # Interactive mode keeps Copilot's normal approval policy intact.
      exec copilot --interactive "$prompt"
    elif has_opencode; then
      exec opencode run --format json "$prompt"
    else
      echo "Copilot not installed. Install via: omarchy default agent copilot" >&2
      exit 3
    fi
    ;;
  grok)
    if [[ -n "$model" ]] && has_opencode; then
      exec opencode run --model "$model" --format json "$prompt"
    elif command -v grok >/dev/null 2>&1; then
      # Preserve the user's configured permission policy; never bypass approvals.
      exec grok -- "$prompt"
    elif has_opencode; then
      exec opencode run --format json "$prompt"
    else
      echo "Grok not installed. Install via: omarchy default agent grok" >&2
      exit 3
    fi
    ;;
  pi)
    if [[ -n "$model" ]] && has_opencode; then
      exec opencode run --model "$model" --format json "$prompt"
    elif command -v pi >/dev/null 2>&1; then
      exec pi "$prompt"
    elif has_opencode; then
      exec opencode run --format json "$prompt"
    else
      echo "Pi not installed. Install via: omarchy default agent pi" >&2
      exit 3
    fi
    ;;
  omp|oh-my-pi)
    if [[ -n "$model" ]] && has_opencode; then
      exec opencode run --model "$model" --format json "$prompt"
    elif command -v omp >/dev/null 2>&1; then
      # Preserve the user's configured approval policy; never auto-approve tools.
      exec omp -- "$prompt"
    elif has_opencode; then
      exec opencode run --format json "$prompt"
    else
      echo "Oh My Pi not installed." >&2
      exit 3
    fi
    ;;
  ori|openrouter)
    if [[ -n "$model" ]] && has_opencode; then
      exec opencode run --model "$model" --format json "$prompt"
    elif command -v ori >/dev/null 2>&1; then
      exec ori code --prompt "$prompt"
    elif has_opencode; then
      exec opencode run --format json "$prompt"
    else
      echo "Ori not installed." >&2
      exit 3
    fi
    ;;
  crush)
    if [[ -n "$model" ]] && has_opencode; then
      exec opencode run --model "$model" --format json "$prompt"
    elif command -v crush >/dev/null 2>&1; then
      exec crush run "$prompt"
    elif has_opencode; then
      exec opencode run --format json "$prompt"
    else
      echo "Crush not installed." >&2
      exit 3
    fi
    ;;
  *)
    # Unknown agent -> try opencode with model if possible
    if has_opencode; then
      if [[ -n "$model" ]]; then
        exec opencode run --model "$model" --format json "$prompt"
      else
        exec opencode run --format json "$prompt"
      fi
    else
      echo "Unsupported agent: $agent" >&2
      exit 2
    fi
    ;;
esac
