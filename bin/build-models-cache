#!/usr/bin/env bash
# build-models-cache: build per-agent model lists in cache from opencode's models.dev cache
# Usage: build-models-cache [--refresh] [--json]
# - Reads ~/.cache/opencode/models.json (4.3M) which contains all providers/models from models.dev
# - Filters per Omarchy agent and writes ~/.cache/omarchy/quick-ai/models.json
# - With --refresh, runs `opencode models --refresh` first to fetch latest from models.dev
set -euo pipefail

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/quick-ai"
CACHE_FILE="$CACHE_DIR/models.json"
OPENCODE_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/opencode/models.json"

mkdir -p "$CACHE_DIR"

if [[ "${1:-}" == "--refresh" ]]; then
  if command -v opencode >/dev/null 2>&1; then
    echo "Refreshing opencode models cache from models.dev..." >&2
    opencode models --refresh >/dev/null 2>&1 || true
  fi
fi

# If opencode cache missing, try to create it
if [[ ! -f "$OPENCODE_CACHE" ]]; then
  if command -v opencode >/dev/null 2>&1; then
    echo "No opencode cache, fetching..." >&2
    opencode models --refresh >/dev/null 2>&1 || true
  fi
fi

if [[ ! -f "$OPENCODE_CACHE" ]]; then
  echo "Warning: opencode cache not found at $OPENCODE_CACHE, using empty fallback" >&2
  # Create minimal fallback with just the models from `opencode models` command (auth-filtered)
  if command -v opencode >/dev/null 2>&1; then
    tmp=$(mktemp)
    opencode models 2>/dev/null | while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      echo "$line"
    done > "$tmp" || true
    # Build minimal JSON from that list
    python3 - "$tmp" "$CACHE_FILE" <<'PY'
import json, sys, pathlib
tmp_path, out_path = sys.argv[1], sys.argv[2]
models = [l.strip() for l in open(tmp_path).read().splitlines() if l.strip()]
# Build per-agent from the flat list
by_agent = {
  "opencode": models,
  "claude": [m for m in models if "claude" in m.lower()],
  "codex": [m for m in models if "gpt" in m.lower() or "codex" in m.lower()],
  "agy": [m for m in models if "gemini" in m.lower()],
  "copilot": [m for m in models if "copilot" in m.lower()],
  "grok": [m for m in models if "grok" in m.lower()],
  "pi": [m for m in models if "pi" in m.lower()],
  "omp": [m for m in models if "omp" in m.lower()],
  "ori": [m for m in models if "openrouter" in m.lower()],
  "crush": [m for m in models if "crush" in m.lower()],
}
# Ensure each has at least a few entries
import os
import datetime
os.makedirs(os.path.dirname(out_path), exist_ok=True)
with open(out_path, 'w') as f:
  json.dump({"generatedAt": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"), "byAgent": by_agent, "all": models}, f, indent=2)
print(f"Wrote fallback cache with {len(models)} models", file=sys.stderr)
PY
    rm -f "$tmp"
    if [[ "${2:-}" == "--json" ]]; then cat "$CACHE_FILE"; else echo "Built fallback cache at $CACHE_FILE" >&2; fi
    exit 0
  else
    echo '{"generatedAt":"unknown","byAgent":{},"all":[]}' > "$CACHE_FILE"
    exit 0
  fi
fi

# Build per-agent lists: `all` from models.dev cache (unfiltered, 5k+), `available` from `opencode models` (auth-filtered, ~20)
python3 - "$OPENCODE_CACHE" "$CACHE_FILE" <<'PY'
import json, sys, subprocess
src, dst = sys.argv[1], sys.argv[2]
data = json.load(open(src))

# Collect all model ids as "provider/model" (full, unfiltered)
all_ids = []
for provider, pdata in data.items():
  models = pdata.get("models", {}) if isinstance(pdata, dict) else {}
  for mid in models.keys():
    if "/" in mid:
      all_ids.append(mid)
    else:
      all_ids.append(f"{provider}/{mid}")
all_ids = sorted(set(all_ids))

# Collect auth-filtered list via `opencode models` (only providers with credentials)
auth_ids = []
try:
  r = subprocess.run(["opencode", "models"], capture_output=True, text=True, timeout=5)
  if r.returncode == 0:
    for line in r.stdout.splitlines():
      s = line.strip()
      if s and "/" in s:
        auth_ids.append(s)
    auth_ids = sorted(set(auth_ids))
except Exception as e:
  auth_ids = []

# Use auth list if available, otherwise fallback to full list
base_ids = auth_ids if auth_ids else all_ids
# For display we keep both: `all` = full (for reference), `available` = auth-filtered
available_ids = auth_ids

def filt_from(ids, needle):
  n = needle.lower()
  return sorted([m for m in ids if n in m.lower()])

# byAgent = per-agent available (auth-filtered) — this is what the dropdown shows
by_agent = {
  "opencode": sorted(base_ids),
  "claude": filt_from(base_ids, "claude"),
  "codex": sorted([m for m in base_ids if "gpt" in m.lower() or "codex" in m.lower()]),
  "agy": filt_from(base_ids, "gemini"),
  "copilot": filt_from(base_ids, "copilot"),
  "grok": filt_from(base_ids, "grok"),
  "pi": filt_from(base_ids, "pi"),
  "omp": filt_from(base_ids, "omp"),
  "ori": filt_from(base_ids, "openrouter"),
  "crush": filt_from(base_ids, "crush"),
}

# allByAgent = per-agent from full list (for reference, not used in dropdown)
all_by_agent = {
  "opencode": sorted(all_ids),
  "claude": filt_from(all_ids, "claude"),
  "codex": sorted([m for m in all_ids if "gpt" in m.lower() or "codex" in m.lower()]),
  "agy": filt_from(all_ids, "gemini"),
  "copilot": filt_from(all_ids, "copilot"),
  "grok": filt_from(all_ids, "grok"),
  "pi": filt_from(all_ids, "pi"),
  "omp": filt_from(all_ids, "omp"),
  "ori": filt_from(all_ids, "openrouter"),
  "crush": filt_from(all_ids, "crush"),
}

# Ensure at least the known defaults are present even if cache is stale
fallbacks = {
  "claude": ["anthropic/claude-sonnet-4-5", "anthropic/claude-opus-4-7", "anthropic/claude-haiku-4-5"],
  "codex": ["openai/gpt-5.6-sol", "openai/gpt-5.4", "openai/gpt-5.5"],
  "agy": ["google/gemini-3.7-flash", "google/gemini-3-pro"],
}
for k, fb in fallbacks.items():
  for m in fb:
    if m not in by_agent[k] and m in all_ids:
      # Only add fallback if it exists in the full catalog (avoid phantom models)
      by_agent[k].append(m)
  by_agent[k] = sorted(set(by_agent[k]))

import datetime as _dt2
out = {
  "generatedAt": _dt2.datetime.now(_dt2.timezone.utc).isoformat().replace("+00:00", "Z"),
  "source": src,
  "all": all_ids,
  "available": available_ids,
  "byAgent": by_agent,
  "allByAgent": all_by_agent
}

import os
os.makedirs(os.path.dirname(dst), exist_ok=True)
with open(dst, 'w') as f:
  json.dump(out, f, indent=2)

if "--json" in sys.argv:
  print(json.dumps(out, indent=2))
else:
  print(f"Built cache at {dst} with {len(all_ids)} total models", file=sys.stderr)
  for k, v in by_agent.items():
    print(f"  {k}: {len(v)}", file=sys.stderr)
PY

if [[ "${1:-}" == "--json" || "${2:-}" == "--json" ]]; then
  cat "$CACHE_FILE"
fi
