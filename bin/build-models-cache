#!/usr/bin/env bash
# build-models-cache: build per-agent model lists in cache from opencode's models.dev cache
# Usage: build-models-cache [--refresh] [--json]
# - Reads $XDG_CACHE_HOME/opencode/models.json (or ~/.cache when unset) from models.dev
# - Filters per Omarchy agent and writes $XDG_CACHE_HOME/omarchy/quick-ai/models.json
# - With --refresh, runs `opencode models --refresh` first to fetch latest from models.dev
set -euo pipefail

# Add mise shims and user bin to PATH so CLI agents like pi can be found
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/quick-ai"
CACHE_FILE="$CACHE_DIR/models.json"
OPENCODE_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/opencode/models.json"

mkdir -p "$CACHE_DIR"

if [[ "${1:-}" == "--refresh" ]]; then
  if command -v opencode >/dev/null 2>&1; then
    echo "Refreshing opencode models cache from models.dev..." >&2
    opencode models --refresh >/dev/null 2>&1 || true
  fi
fi

# If opencode cache missing, try to create it
if [[ ! -f "$OPENCODE_CACHE" ]]; then
  if command -v opencode >/dev/null 2>&1; then
    echo "No opencode cache, fetching..." >&2
    opencode models --refresh >/dev/null 2>&1 || true
  fi
fi

if [[ ! -f "$OPENCODE_CACHE" ]]; then
  echo "Warning: opencode cache not found at $OPENCODE_CACHE, using empty fallback" >&2
  # Create minimal fallback with just the models from `opencode models` command (auth-filtered)
  if command -v opencode >/dev/null 2>&1; then
    tmp=$(mktemp)
    opencode models 2>/dev/null | while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      echo "$line"
    done > "$tmp" || true
    # Build minimal JSON from that list
    python3 - "$tmp" "$CACHE_FILE" <<'PY'
import json, sys, os, re, datetime
tmp_path, out_path = sys.argv[1], sys.argv[2]
models = [l.strip() for l in open(tmp_path).read().splitlines() if l.strip()]

def filter_agent_models(agent_name, ids):
  a = agent_name.lower()
  out = []
  for m in ids:
    low = m.lower()
    prov, _, name = low.partition("/")
    if a == "opencode":
      out.append(m)
    elif a == "claude":
      if prov in ("anthropic", "claude") or "claude" in name:
        out.append(m)
    elif a == "codex":
      if prov == "openai" or "gpt" in name or "codex" in name:
        out.append(m)
    elif a in ("agy", "gemini", "antigravity"):
      if prov == "google" or "gemini" in name:
        out.append(m)
    elif a == "copilot":
      if prov == "github-copilot" or "copilot" in low:
        out.append(m)
    elif a == "grok":
      if prov == "x-ai" or "grok" in name:
        out.append(m)
    elif a in ("pi", "omp"):
      if prov in ("pi", "omp") or re.search(r"(^|[/_-])pi([/_-]|$)", low):
        out.append(m)
    elif a in ("ori", "openrouter"):
      if prov == "openrouter" or "openrouter" in low:
        out.append(m)
    elif a == "crush":
      if prov == "crush" or re.search(r"(^|[/_-])crush([/_-]|$)", low):
        out.append(m)
  return sorted(set(out))

agents = ["opencode", "claude", "codex", "agy", "copilot", "grok", "pi", "omp", "ori", "crush"]
by_agent = {ag: filter_agent_models(ag, models) for ag in agents}
try:
  import subprocess
  r_pi = subprocess.run(["pi", "--list-models"], capture_output=True, text=True, timeout=4)
  if r_pi.returncode == 0:
    pi_native = []
    for line in r_pi.stdout.splitlines()[1:]:
      parts = line.split()
      if len(parts) >= 2 and "/" not in parts[0]:
        pi_native.append(f"{parts[0]}/{parts[1]}")
    if pi_native:
      by_agent["pi"] = sorted(set(by_agent.get("pi", []) + pi_native))
      models = sorted(set(models + pi_native))
except Exception:
  pass
os.makedirs(os.path.dirname(out_path), exist_ok=True)
tmp_out = out_path + ".tmp"
with open(tmp_out, 'w') as f:
  json.dump({"generatedAt": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"), "byAgent": by_agent, "all": models}, f, indent=2)
os.replace(tmp_out, out_path)
print(f"Wrote fallback cache with {len(models)} models", file=sys.stderr)
PY
    rm -f "$tmp"
    if [[ "${2:-}" == "--json" ]]; then cat "$CACHE_FILE"; else echo "Built fallback cache at $CACHE_FILE" >&2; fi
    exit 0
  else
    echo "Error: opencode is unavailable, so no models cache could be built" >&2
    exit 1
  fi
fi

# Build per-agent lists: `all` from models.dev cache (unfiltered, 5k+), `available` from `opencode models` (auth-filtered, ~20)
python3 - "$OPENCODE_CACHE" "$CACHE_FILE" <<'PY'
import json, sys, subprocess
src, dst = sys.argv[1], sys.argv[2]
data = json.load(open(src))

# Collect all model ids as "provider/model" (full, unfiltered)
all_ids = []
for provider, pdata in data.items():
  models = pdata.get("models", {}) if isinstance(pdata, dict) else {}
  for mid in models.keys():
    if "/" in mid:
      all_ids.append(mid)
    else:
      all_ids.append(f"{provider}/{mid}")
all_ids = sorted(set(all_ids))

# Collect auth-filtered list via `opencode models` (only providers with credentials)
auth_ids = []
try:
  r = subprocess.run(["opencode", "models"], capture_output=True, text=True, timeout=5)
  if r.returncode == 0:
    for line in r.stdout.splitlines():
      s = line.strip()
      if s and "/" in s:
        auth_ids.append(s)
    auth_ids = sorted(set(auth_ids))
except Exception as e:
  auth_ids = []

# Use auth list if available, otherwise fallback to full list
base_ids = auth_ids if auth_ids else all_ids
# For display we keep both: `all` = full (for reference), `available` = auth-filtered
available_ids = auth_ids

import re

def filter_agent_models(agent_name, ids):
  a = agent_name.lower()
  out = []
  for m in ids:
    low = m.lower()
    prov, _, name = low.partition("/")
    if a == "opencode":
      out.append(m)
    elif a == "claude":
      if prov in ("anthropic", "claude") or "claude" in name:
        out.append(m)
    elif a == "codex":
      if prov == "openai" or "gpt" in name or "codex" in name:
        out.append(m)
    elif a in ("agy", "gemini", "antigravity"):
      if prov == "google" or "gemini" in name:
        out.append(m)
    elif a == "copilot":
      if prov == "github-copilot" or "copilot" in low:
        out.append(m)
    elif a == "grok":
      if prov == "x-ai" or "grok" in name:
        out.append(m)
    elif a in ("pi", "omp"):
      # Only match genuine pi models; avoid matching words like 'pickle'
      if prov in ("pi", "omp") or re.search(r"(^|[/_-])pi([/_-]|$)", low):
        out.append(m)
    elif a in ("ori", "openrouter"):
      if prov == "openrouter" or "openrouter" in low:
        out.append(m)
    elif a == "crush":
      if prov == "crush" or re.search(r"(^|[/_-])crush([/_-]|$)", low):
        out.append(m)
  return sorted(set(out))

# Query native models for CLI agents that manage their own provider catalogs
pi_native_models = []
try:
  r_pi = subprocess.run(["pi", "--list-models"], capture_output=True, text=True, timeout=4)
  if r_pi.returncode == 0:
    for line in r_pi.stdout.splitlines()[1:]:
      parts = line.split()
      if len(parts) >= 2 and "/" not in parts[0]:
        pi_native_models.append(f"{parts[0]}/{parts[1]}")
    pi_native_models = sorted(set(pi_native_models))
except Exception:
  pi_native_models = []

if pi_native_models:
  all_ids = sorted(set(all_ids + pi_native_models))
  available_ids = sorted(set(available_ids + pi_native_models))

# byAgent = per-agent available (auth-filtered) — this is what the dropdown shows
by_agent = {
  "opencode": filter_agent_models("opencode", base_ids),
  "claude": filter_agent_models("claude", base_ids),
  "codex": filter_agent_models("codex", base_ids),
  "agy": filter_agent_models("agy", base_ids),
  "copilot": filter_agent_models("copilot", base_ids),
  "grok": filter_agent_models("grok", base_ids),
  "pi": sorted(set(pi_native_models + filter_agent_models("pi", base_ids))),
  "omp": filter_agent_models("omp", base_ids),
  "ori": filter_agent_models("ori", base_ids),
  "crush": filter_agent_models("crush", base_ids),
}

# allByAgent = per-agent from full list (for reference, not used in dropdown)
all_by_agent = {
  "opencode": filter_agent_models("opencode", all_ids),
  "claude": filter_agent_models("claude", all_ids),
  "codex": filter_agent_models("codex", all_ids),
  "agy": filter_agent_models("agy", all_ids),
  "copilot": filter_agent_models("copilot", all_ids),
  "grok": filter_agent_models("grok", all_ids),
  "pi": sorted(set(pi_native_models + filter_agent_models("pi", all_ids))),
  "omp": filter_agent_models("omp", all_ids),
  "ori": filter_agent_models("ori", all_ids),
  "crush": filter_agent_models("crush", all_ids),
}

import datetime as _dt2
out = {
  "generatedAt": _dt2.datetime.now(_dt2.timezone.utc).isoformat().replace("+00:00", "Z"),
  "source": src,
  "all": all_ids,
  "available": available_ids,
  "byAgent": by_agent,
  "allByAgent": all_by_agent
}

import os
os.makedirs(os.path.dirname(dst), exist_ok=True)
tmp_dst = dst + ".tmp"
with open(tmp_dst, 'w') as f:
  json.dump(out, f, indent=2)
os.replace(tmp_dst, dst)

if "--json" in sys.argv:
  print(json.dumps(out, indent=2))
else:
  print(f"Built cache at {dst} with {len(all_ids)} total models", file=sys.stderr)
  for k, v in by_agent.items():
    print(f"  {k}: {len(v)}", file=sys.stderr)
PY

if [[ "${1:-}" == "--json" || "${2:-}" == "--json" ]]; then
  cat "$CACHE_FILE"
fi
